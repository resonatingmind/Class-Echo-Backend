# Copy to deploy/ec2/.env on the server:  cp .env.example .env
# bootstrap.sh generates SECRET_KEY only if it is left empty. To keep existing
# users logged in, paste the SECRET_KEY of the current deployment instead.

# ── Public address ───────────────────────────────────────────────────────────
# :80 for plain HTTP on the instance IP. Change to your API domain
# (e.g. api.yourdomain.com) once its DNS A record points at the Elastic IP;
# Caddy then fetches an HTTPS certificate automatically.
SITE_ADDRESS=:80

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase → Connect. Use the Supavisor pooler host
# (aws-0-<region>.pooler.supabase.com), never db.<ref>.supabase.co (IPv6-only).
# Runtime: transaction pooler, port 6543, asyncpg driver:
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Migrations: session pooler, port 5432, plain scheme:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
MIGRATION_DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=129600

# ── Super admin (created on first start only if this email doesn't exist) ────
ADMIN_NAME=Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── File storage (pick ONE) ──────────────────────────────────────────────────
# Cloudinary takes priority over S3 whenever any CLOUDINARY_* value is set.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# S3: keys of an IAM user limited to this bucket (see README).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_STORAGE_BUCKET_NAME=

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Where the web app is served; used in emailed invite/verification links.
FRONTEND_URL=https://class-echo-frontend.vercel.app
# Comma-separated extra origins allowed to call the API.
ALLOWED_ORIGINS=https://class-echo-frontend.vercel.app

# ── Worker ───────────────────────────────────────────────────────────────────
# Parallel Celery processes. 1 suits t3.small (2 GB); 2 on 4 GB; 3-4 on 8 GB.
CELERY_CONCURRENCY=1

# ── Email (configure ONE provider; first one set wins) ───────────────────────
EMAIL_FROM_NAME=Class Echo
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_FROM_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# ── Never enable on this server: wipes the Supabase database ─────────────────
RESET_DB_ON_STARTUP=false
ENVIRONMENT=production
