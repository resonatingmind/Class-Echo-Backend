# ── Database ───────────────────────────────────────────────────────────────────
# Local Docker postgres (recommended for dev/testing — fast, no network latency)
DATABASE_URL=postgresql+asyncpg://scholar:scholar@localhost:5432/scholarmetric

# ── Supabase (production) ──────────────────────────────────────────────────────
# Set these in the Render dashboard, NOT in a committed file.
#
# Use the Supavisor pooler hostname, never db.<ref>.supabase.co — the direct
# host is IPv6-only and unreachable from Render.
#
# Runtime (transaction pooler, port 6543). app/database.py detects the "pooler."
# host and disables prepared-statement caching, which transaction pooling breaks.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Migrations + DDL (session pooler, port 5432). Alembic holds one backend for a
# whole transaction and needs an advisory lock, so it cannot use 6543.
# Omit this and migrations run over DATABASE_URL instead.
# MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Danger zone ────────────────────────────────────────────────────────────────
# start.sh runs `reset_db.py --yes` (drops the whole public schema) when either
# of these is set. Never set them on a deploy pointed at Supabase. reset_db.py
# now refuses a non-local host unless ALLOW_REMOTE_DB_WIPE=true.
# ENVIRONMENT=test
# RESET_DB_ON_STARTUP=false

# ── Gemini ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-secret-key-here-change-in-production

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
# 90 days (129600). Use a lower value in dev if you want faster expiry testing.
ACCESS_TOKEN_EXPIRE_MINUTES=129600

# ── Super Admin seed credentials ───────────────────────────────────────────────
# Used by seed_admin.py to create the first admin user non-interactively.
# Change these before seeding production.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@scholarmetric.com
ADMIN_PASSWORD=changeme123

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Redis (local Docker) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# On Render, point this at the Key Value instance internal URL. Note that the
# free plan is in-memory only: queued Celery tasks are lost on every restart.
# Recordings survive (rows in Supabase, audio in Cloudinary) but can be left
# stuck at status=pending, and queued invite emails are lost outright.

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1
AWS_STORAGE_BUCKET_NAME=test-bucket
